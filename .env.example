# =====================================================================
# CẤU HÌNH MÔI TRƯỜNG DỰ ÁN TRỢ LÝ K12ONLINE AI (COMMUNITY)
# =====================================================================

# 1. Google Gemini API Keys (Hỗ trợ xoay vòng nhiều key ngăn cách bởi dấu phẩy)
# Lấy miễn phí tại: https://aistudio.google.com
GEMINI_API_KEYS=your-gemini-key-1,your-gemini-key-2

# 2. OpenRouter API Keys (Dự phòng xoay tua ngăn cách bởi dấu phẩy)
# Ví dụ: sk-or-v1-key1,sk-or-v1-key2,sk-or-v1-key3
OPENROUTER_API_KEYS=sk-or-v1-your-key-here

# 3. Supabase Configuration (Quản lý User & Lịch sử Chat - Tùy chọn)
# Lấy miễn phí tại: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 4. Cloudflare Turnstile (Xác minh chống Bot độc hại - Khuyến nghị cho Production)
# Lấy miễn phí tại Cloudflare Dashboard > Turnstile
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# 5. Upstash Redis Cloud Cache (Lưu bộ nhớ đệm câu trả lời 30ms & Rate Limit 20 req/phút)
# Tạo database Redis miễn phí tại: https://console.upstash.com hoặc Vercel Storage
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 6. Telegram Bot Alert (Cảnh báo sự cố, rate limit & góp ý người dùng 24/7)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 7. Quản trị viên & Bảo mật Admin Dashboard (/admin & /api/admin/*)
# Danh sách email admin được cấp quyền (ngăn cách bởi dấu phẩy)
ADMIN_EMAILS=thieuhoangent@gmail.com,thieuviethoang7b@gmail.com

# Khóa bí mật Admin bắt buộc để xác thực các API /api/admin/* (Chống truy cập trái phép)
ADMIN_SECRET_KEY=your-super-secret-admin-key-here
